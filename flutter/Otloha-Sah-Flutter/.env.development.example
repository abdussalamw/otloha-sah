# بيئة تطوير Flutter فقط — انسخ هذا الملف إلى .env ولا ترفعه إلى Git.
# Android Emulator: استخدم 10.0.2.2 للوصول إلى جهاز التطوير.
# iOS Simulator أو Windows/macOS/Linux: استخدم 127.0.0.1.
# هاتف حقيقي: استبدل 10.0.2.2 بعنوان LAN لجهاز التطوير، مثل 192.168.1.50.
APP_ENV=development
TESTING_BASE_URL=http://10.0.2.2:8000
TESTING_SOCKET_URL=ws://10.0.2.2:8000
QURAN_API_BASE_URL=http://10.0.2.2:8001

# مصدر المحتوى الثابت (المصحف/التفسير/توزيع الكلمات وخطوط حفص) مستقل عن خادم الحسابات.
# يقبل التطبيق HTTPS فقط، ويبقى رابط إصدار v4.0 الافتراضي مستخدماً عند ترك القيمة فارغة.
QURAN_CONTENT_RELEASE_BASE_URL=https://github.com/abdussalamw/otloha-sah/releases/download/v4.0-otloha-sah

# تظل هذه فارغة في بيئة التطوير؛ لا تُنسخ أسرار الإنتاج هنا.
PRODUCTION_BASE_URL=
PRODUCTION_SOCKET_URL=
SENTRY_DSN=
SLACK_WEBHOOK_URL=
