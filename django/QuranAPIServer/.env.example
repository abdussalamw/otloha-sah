# =============================== Django ===============================
SECRET_KEY=replace-with-a-unique-secret-key
ALLOWED_HOSTS=127.0.0.1,quranapi.me
DEBUG=false

# ============================ let's Encrypt ============================
DOMAIN=quranapi.me
ACME_DEFAULT_EMAIL=

# =============================== Postgres ===============================
DATABASE_ENGINE=django.db.backends.postgresql_psycopg2
DATABASE_NAME=default
DATABASE_USER=default
DATABASE_PASS=secret
DATABASE_HOST=db
DATABASE_PORT=5432

# =============================== REDIS ===============================
REDIS_HOST=redis
REDIS_PORT=6379
# استخدم قيمة طويلة وعشوائية ولا تحفظها في Git.
REDIS_PASSWORD=replace-with-a-strong-random-password
REDIS_URL=redis://:replace-with-a-strong-random-password@redis:6379/0

# =============================== Celery ===============================
CELERY_BROKER_URL=redis://:replace-with-a-strong-random-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:replace-with-a-strong-random-password@redis:6379/0

# =============================== Email ===============================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
EMAIL_USE_SSL=
EMAIL_TIMEOUT=
EMAIL_SSL_KEYFILE=
EMAIL_SSL_CERTFILE=
