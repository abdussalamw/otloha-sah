# بيئة تطوير محلية فقط — انسخ هذا الملف إلى .env.local ولا ترفعه إلى Git.
SECRET_KEY=replace-with-a-local-development-secret
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=false
MIN_APP_VERSION=0.0.0

# قاعدة بيانات مستقلة عن الإنتاج.
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.local.sqlite3

# Redis اختياري أثناء تطوير HTTP محلياً؛ شغّله عند اختبار Celery أو WebSockets.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# شغّل QuranAPI محلياً على المنفذ 8001 عند الحاجة إلى بيانات القرآن.
QURAN_API_CLIENT_URL=http://127.0.0.1:8001/
QURAN_API_CLIENT_ID=
QURAN_API_CLIENT_SECRET=

# يمنع الإرسال الفعلي للبريد والرسائل في بيئة التطوير.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
PHONE_VERIFY_SERVICE=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PREMIUM_ENABLED=false

# اترك تكاملات الإنتاج معطلة محلياً.
FCM_CRED_CERTIFICATE=
SOCIAL_AUTH_GSI_KEY=
SOCIAL_X_CLIENT_ID=
SOCIAL_X_CLIENT_SECRET=
SOCIAL_X_REDIRECT_URI=
SOCIAL_APPLE_CLIENT_ID=
