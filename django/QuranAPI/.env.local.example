# بيئة تطوير محلية فقط — انسخ هذا الملف إلى .env.local ولا ترفعه إلى Git.
SECRET_KEY=replace-with-a-local-development-secret
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=false

# قاعدة بيانات مستقلة عن الإنتاج.
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.local.sqlite3

# لا يلزم Redis أو Celery لتشغيل واجهات القراءة الأساسية محلياً.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://

# يطبع البريد في طرفية التطوير بدلاً من الإرسال الفعلي.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
